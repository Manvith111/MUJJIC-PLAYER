# Copy this to `.env` on your server and fill in values.
#   cp .env.example .env
# Every var here is read by server/config.py. All are optional except where noted.

# CORS. "*" is fine while the app is the only client. If you put the backend
# behind a public domain and want to lock it down, set your app origin(s).
TM_CORS_ORIGINS=*

# Seconds a resolved stream URL is trusted before re-resolving. Don't go too low
# or seeking re-triggers yt-dlp extraction. Default 1800 (30 min).
TM_STREAM_URL_TTL=1800

# Download audio container. m4a is small + Android-friendly (leave as-is).
TM_DOWNLOAD_FORMAT=m4a

# YouTube Data API key — used to read PUBLIC playlists without OAuth.
# IMPORTANT: a key is currently hardcoded in server/config.py:27. Replace it with
# your OWN key here and rotate/remove the hardcoded one (see DEPLOY.md "Secrets").
# Get one at https://console.cloud.google.com/ (enable "YouTube Data API v3").
TM_YOUTUBE_API_KEY=

# Where downloads + caches are stored INSIDE the container. Leave as /data when
# using Docker (compose mounts the tm-data volume there). Only change for a bare
# (non-Docker / systemd) install — see DEPLOY.md.
TM_DATA_DIR=/data
